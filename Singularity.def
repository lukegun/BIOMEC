BootStrap: debootstrap
OSVersion: noble
MirrorURL: http://us.archive.ubuntu.com/ubuntu/

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/runcode
    mkdir -p ${SINGULARITY_ROOTFS}/venvs  
	cp -R src/BIOMEC/. ${SINGULARITY_ROOTFS}/runcode/
    cp requirements.txt ${SINGULARITY_ROOTFS}/venvs/requirements.txt

%files


# this stores key varibles
%environment
    export VENVPYTHONPATH=${SINGULARITY_ROOTFS}/venvs/venv/python3
    

%runscript

	# var 1 = Input file
    if [ $# -ne 1 ];
	then
       echo "Please provide an Input file."
       exit 1
    fi
	
	echo "running"
	${SINGULARITY_ROOTFS}/venvs/venv/bin/python ${SINGULARITY_ROOTFS}/runcode/main.py $1
    
	echo "finished"
    

%labels 
    AUTHOR Luke Gundry
	MECSim Aurthor: Gareth Kennedy
	
	Licenses as per documentation
	
	Currenly set up to run on python 3.12 in unbuntu bionic working in a singulrity Version 3.1 container though higher should work

%post
    
	# install packages and python modules
    apt-get -y update
    apt-get -y install build-essential git
    apt-get -y install gfortran
    apt-get -y install python3.12
    apt-get -y install software-properties-common
	apt-get -y install bc
    apt-add-repository  universe
    apt-get update
    apt-get -y install python3-pip python3.12-dev
    
    # create the virtual enviroment
    apt -y install python3-venv
    python3 -m venv ${SINGULARITY_ROOTFS}/venvs/venv

    # install to the virtual enviroment
    ${SINGULARITY_ROOTFS}/venvs/venv/bin/pip install --upgrade pip
    ${SINGULARITY_ROOTFS}/venvs/venv/bin/pip install -r ${SINGULARITY_ROOTFS}/venvs/requirements.txt
	
	# change permissions of files
    chmod -R 777 ${SINGULARITY_ROOTFS}/runcode
